{
  "name": "@aisus/workspace",
  "version": "0.3.0",
  "private": true,
  "description": "The aisus repository: shared packages, the apps that ship them, and the gates.",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/vscode",
    "apps/cloud"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "action": "node esbuild.mjs --action",
    "build:release": "node tools/scripts/release.mjs",
    "bench": "node esbuild.mjs --bench && node out/bench/bench.mjs",
    "bench:plan": "node esbuild.mjs --bench && node out/bench/plan.mjs",
    "bench:fit": "node esbuild.mjs --bench && node out/bench/fit.mjs",
    "eval": "node esbuild.mjs --bench && node out/eval/score.mjs",
    "eval:check-truth": "node esbuild.mjs --bench && node out/eval/check-truth.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:docs": "node tools/scripts/check-docs.mjs",
    "notices": "node tools/scripts/notices.mjs --write",
    "check:notices": "node tools/scripts/notices.mjs --check",
    "check": "npm run typecheck && npm run test && npm run check:docs && npm run build && npm run check:notices",
    "test:e2e": "npm run build && node esbuild.mjs --e2e && node apps/vscode/out/e2e/runTest.js",
    "package": "node tools/scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "mocha": "12.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
