# The site on {$DOMAIN} and Umami's dashboard on stats.{$DOMAIN}, each with an automatic HTTPS
# certificate. The site's /stats/ path carries only Umami's script and collector, so pages count
# visits without a request leaving the site. Grafana sits under /grafana with its own login.
{
	metrics
}

{$DOMAIN} {
	encode zstd gzip

	handle_path /stats/* {
		@tracker path /script.js /api/send
		handle @tracker {
			reverse_proxy umami:3000
		}
		respond 404
	}

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Prometheus reads the cloud's metrics inside the compose network only.
	handle /api/metrics {
		respond 404
	}

	handle {
		reverse_proxy cloud:3000
	}
}

stats.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}

# Prometheus reads Caddy's own metrics here, inside the compose network.
http://:2020 {
	metrics
}
