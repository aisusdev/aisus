# The deployer's secrets, in ~/.config/aisus/secrets.env (chmod 600), never in the repository.
# deploy.sh fills in the generated ones on first use and copies them into the server's .env.

# The site's domain. Until it points at the server, deploy.sh uses <ip>.sslip.io.
DOMAIN=

# From the GitHub OAuth app whose callback is https://$DOMAIN/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe, in test mode first. stripe-setup.sh adds the Pro and Team prices, their text and the webhook's secret.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE=
STRIPE_TEAM_PRICE=
STRIPE_WEBHOOK_SECRET=
AISUS_PRO_PRICE_TEXT=
AISUS_TEAM_PRICE_TEXT=

# The repository whose releases /install points at.
AISUS_RELEASES_REPO=kerktaiheng/aisus

# Set by deploy.sh after it creates the Umami website.
UMAMI_WEBSITE_ID=

# Generated by deploy.sh on first use.
NEXTAUTH_SECRET=
METRICS_TOKEN=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
UMAMI_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
